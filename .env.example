# =============================================================================
# arXiv Digest Agent — configuration
# Copy this file to `.env` and fill in ONE provider. No paid key is required.
# =============================================================================

# Which LLM provider to use: groq | gemini | ollama
# - groq   : free tier, fast. Get a free key at https://console.groq.com/keys
# - gemini : free tier. Get a free key at https://aistudio.google.com/app/apikey
# - ollama : fully local, NO key needed. Requires `ollama serve` running.
LLM_PROVIDER=groq

# ---- Groq (free tier) -------------------------------------------------------
GROQ_API_KEY=
# Any current Groq-hosted open model. Default is a good, capable choice.
# See the live list at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# ---- Google Gemini (free tier) ----------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Ollama (local, no key) -------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Retrieval / storage (sane defaults; usually leave as-is) ---------------
# Directory for the persistent Chroma vector DB.
CHROMA_DIR=./data/chroma
# Where downloaded PDFs, briefings and QA sessions are stored.
OUTPUT_DIR=./data/output
# Chunking (characters). Section-aware chunking with overlap.
CHUNK_SIZE=1100
CHUNK_OVERLAP=150
# How many chunks to retrieve for a QA answer.
QA_TOP_K=6
# Cap pages parsed for very large PDFs (0 = no cap).
MAX_PDF_PAGES=80
# How many candidates to fetch for a topic search.
TOPIC_MAX_RESULTS=8
